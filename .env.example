# 私密設定：請複製為 .env 後填入自己的 API Key。不要把 .env 傳給他人或上傳。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=12

# Edge TTS 普通話女聲
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+5%
EDGE_TTS_VOLUME=+0%
TTS_TIMEOUT_SECONDS=25

# 如 Arduino 沒有被自動偵測，可填入例如 COM3；留空則自動偵測。
SERIAL_PORT=
